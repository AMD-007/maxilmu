# Custom 404 page (Apache/XAMPP). Requires AllowOverride to include
# FileInfo (or All) for this directory in httpd.conf — XAMPP's default
# config already allows this for htdocs.
#
# NOTE: this path assumes the site is deployed at its own domain root
# (production docroot = this folder), which is the standard setup for
# a real hosting deployment. If you're testing locally through a
# subfolder URL instead — e.g. http://localhost/Maahad_Baitur_Rahman/ —
# Apache resolves a leading-slash ErrorDocument path against the
# *server's* DocumentRoot, not this folder, so this line will 404 on
# the 404 page itself in that context. Swap it for the commented line
# below when testing that way.
ErrorDocument 404 /404.html
# ErrorDocument 404 /Maahad_Baitur_Rahman/404.html

# Short, memorable URL for the login page. Teachers/admin can bookmark
# or be told "/login" instead of "/app/login.html". It's a real
# redirect (not an internal rewrite) so login.html's existing relative
# asset paths (../styles.css, app.css, data.js, etc.) keep resolving
# correctly against the real /app/login.html URL.
#
# RewriteBase matters here: without it, mod_rewrite guesses the URL
# prefix from the filesystem path, and that guess is only correct when
# this folder IS the server's DocumentRoot (the production setup — see
# note above). Same subfolder caveat as ErrorDocument above: swap the
# RewriteBase line when testing at http://localhost/Maahad_Baitur_Rahman/.
RewriteEngine On
RewriteBase /
# RewriteBase /Maahad_Baitur_Rahman/
RewriteRule ^login/?$ app/login.html [R=302,L]

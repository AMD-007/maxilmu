{
  // Cloudflare Workers static-asset deployment.
  // `npx wrangler deploy` from repo root publishes everything tracked by
  // git (respecting .gitignore) except .git/ itself.
  // `npx wrangler dev` starts a local preview at http://localhost:8787.
  "name": "maahad-cahaya-ilmu",
  "compatibility_date": "2025-01-01",

  "assets": {
    // Serve from repo root (all web files live here — no public/ subdir).
    "directory": ".",
    // Return 404.html with a 404 status for any unmatched path, instead
    // of Cloudflare's generic "not found" page.
    "not_found_handling": "404-page"
  }
}
